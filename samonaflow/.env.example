# Supabase connection strings are found in:
# Supabase Dashboard > Project Settings > Database > Connection string
# Replace the placeholders below with your own values. Never commit real credentials.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public origin of this app, used to build absolute Supabase auth redirect URLs.
# Local: http://localhost:3000 | Production: https://your-domain.example
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Runtime app connection via the Supabase Transaction pooler (port 6543).
# Used by the app at runtime.
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require

# Direct connection for migrations and the Prisma CLI only (port 5432).
# Direct connection for migrations only; never used at runtime.
# If the direct host is not IPv4-compatible, use the Session pooler on port 5432 instead.
DIRECT_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require
